cts" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="210"/><column index="2" value="79"/><column index="3" value="94"/><column index="4" value="91"/><column index="5" value="210"/><column index="6" value="110"/><column index="7" value="82"/><column index="8" value="60"/><column index="9" value="52"/><column index="10" value="87"/><column index="11" value="97"/><column index="12" value="122"/><column index="13" value="61"/><column index="14" value="94"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="v_weekly_metrics" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="94"/><column index="2" value="51"/><column index="3" value="44"/><column index="4" value="65"/><column index="5" value="46"/><column index="6" value="46"/><column index="7" value="110"/><column index="8" value="116"/><column index="9" value="118"/><column index="10" value="90"/><column index="11" value="128"/><column index="12" value="125"/><column index="13" value="112"/><column index="14" value="162"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">WITH p AS (SELECT '2018-08-26' AS report_week)
SELECT p.report_week,
       COUNT(DISTINCT f.order_date) AS days_with_orders,
       CASE WHEN COUNT(DISTINCT f.order_date) = 7 THEN 'PASS'
            ELSE 'FAIL -- pick an earlier week' END AS result
FROM v_order_facts f, p
WHERE f.week_ending = p.report_week
GROUP BY p.report_week;</sql><sql name="SQL 2*">-- ---------------------------------------------------------------------------
WITH p AS (SELECT '2018-08-26' AS report_week)
SELECT 'Report week'         AS period, w.week_ending, w.orders, w.revenue
FROM v_weekly_metrics w, p WHERE w.week_ending = p.report_week
UNION ALL
SELECT 'Prior week',           w.week_ending, w.orders, w.revenue
FROM v_weekly_metrics w, p WHERE w.week_ending = date(p.report_week, '-7 days')
UNION ALL
SELECT 'Same week last year', w.week_ending, w.orders, w.revenue
FROM v_weekly_metrics w, p WHERE w.week_ending = date(p.report_week, '-364 days');
</sql><current_tab id="1"/></tab_sql></sqlb_project>
